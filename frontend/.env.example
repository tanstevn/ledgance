# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Only NEXT_PUBLIC_* values reach the browser bundle — never put a service-role key here.

NEXT_PUBLIC_API_URL=http://localhost:5253
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
