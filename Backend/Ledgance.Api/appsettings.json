{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Supabase": {
    "Url": "https://your-project-ref.supabase.co",
    "AnonKey": "replace-with-supabase-anon-key",
    "ServiceRoleKey": "replace-with-supabase-service-role-key",
    "JwtSecret": "replace-with-supabase-jwt-secret",
    "Audience": "authenticated"
  },
  "Subscriptions": {
    "Plans": {}
  },
  "Stripe": {
    "SecretKey": "sk_test_replace_me",
    "PublishableKey": "pk_test_replace_me",
    "WebhookSecret": "whsec_replace_me"
  },
  "Ai": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434"
    },
    "OpenAI": {
      "BaseUrl": "https://api.openai.com",
      "ApiKey": "replace-with-openai-api-key"
    },
    "Anthropic": {
      "ApiKey": "replace-with-anthropic-api-key"
    },
    "OpenClaw": {
      "BaseUrl": "https://replace-with-openclaw-endpoint",
      "ApiKey": "replace-with-openclaw-api-key"
    },
    "Routing": {
      "basic": { "Provider": "Ollama", "Model": "llama3.1:8b", "MaxOutputTokens": 2048 },
      "advanced": { "Provider": "OpenAI", "Model": "gpt-4o", "MaxOutputTokens": 4096 },
      "reasoning": { "Provider": "Anthropic", "Model": "claude-opus-5", "MaxOutputTokens": 8192 },
      "agentic": { "Provider": "OpenClaw", "Model": "openclaw-agent-1", "MaxOutputTokens": 8192 }
    }
  }
}
